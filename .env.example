# Bot token from the Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=

# Optional: path to a Netscape-format cookies.txt exported from a browser
# signed in to YouTube. Helps with "Sign in to confirm you're not a bot".
COOKIES_FILE=

# Optional: set to 1 to log voice/playback debug info and a health line
# 5 seconds into every track (frames sent, DAVE encryption state).
DEBUG_VOICE=
